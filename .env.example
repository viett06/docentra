# PostgreSQL on Docker, accessible from the host machine only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=docentra
POSTGRES_USER=docentra
POSTGRES_PASSWORD=change_this_local_password

# Optional override for Alembic. Keep secrets out of alembic.ini.
# DATABASE_URL=postgresql+psycopg://docentra:password@127.0.0.1:5433/docentra

# Local synthetic MVP (never use demo accounts with real employee data).
DEMO_MODE=true
DEMO_PASSWORD=DocentraDemo!2026
COOKIE_SECURE=false
S3_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=docentra-local-admin
S3_SECRET_KEY=change_this_storage_password
S3_BUCKET=docentra-private
